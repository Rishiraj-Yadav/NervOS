{
  "name": "nervos-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.12.0 <25",
    "pnpm": ">=10.28.0 <11"
  },
  "scripts": {
    "build": "pnpm --filter @nervos/web build",
    "dev:web": "pnpm --filter @nervos/web dev",
    "lint": "pnpm --filter @nervos/web lint",
    "test": "pnpm --filter @nervos/web test",
    "typecheck": "pnpm --filter @nervos/web typecheck"
  }
}
