# Documentation only; NervOS does not load this file automatically.
NERVOS_ENVIRONMENT=development
NERVOS_DATABASE_PATH=~/.nervos/nervos.db
NERVOS_APP_ORIGIN=http://localhost:5173
NERVOS_LOG_LEVEL=INFO
NERVOS_MAX_PENDING_JOBS=1000
NERVOS_MAX_PENDING_JOBS_PER_AGENT=1000
NERVOS_MAX_PENDING_JOBS_PER_PROVIDER=1000
NERVOS_WORKER_CONCURRENCY=1
NERVOS_MAX_ACTIVE_JOBS=4
# Test-only; production should leave unset.
# NERVOS_WORKER_READY_FILE=
# Provider credentials are read only by the Worker process.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Stage H1 (ADR 0032): the operator-owned master key for the encrypted Secret Manager.
# The file holds exactly one base64-encoded 32-byte key and must never be committed. A
# missing, unreadable, or malformed file makes every secret operation fail closed -- there
# is no plaintext fallback and no default key.
# NERVOS_SECRETS_KEY_FILE=~/.nervos/secrets.key
# NERVOS_SECRETS_KEY_VERSION=1
# Generate one with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())" > ~/.nervos/secrets.key
# OAuth providers and account-tool bindings are Worker-only JSON configuration. Keep actual
# client secrets in an OS-managed process environment, never in this file or an agent package.
# NERVOS_ACCOUNT_OAUTH_PROVIDERS=[]
# NERVOS_ACCOUNT_TOOL_BINDINGS=[]
