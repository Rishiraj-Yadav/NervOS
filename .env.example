# Documentation only; NervOS does not load this file automatically.
NERVOS_ENVIRONMENT=development
NERVOS_DATABASE_PATH=~/.nervos/nervos.db
NERVOS_APP_ORIGIN=http://localhost:5173
NERVOS_LOG_LEVEL=INFO
NERVOS_MAX_PENDING_JOBS=1000
NERVOS_WORKER_CONCURRENCY=1
NERVOS_MAX_ACTIVE_JOBS=4
# Test-only; production should leave unset.
# NERVOS_WORKER_READY_FILE=
# Provider credentials are read only by the Worker process.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
